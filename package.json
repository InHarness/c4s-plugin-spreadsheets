{
  "name": "c4s-plugin-spreadsheets",
  "version": "0.0.3",
  "description": "claude4spec plugin (host API 1.0.0) contributing a hidden `spreadsheet` entity type — a named rows×columns grid of string cells, embedded via <spreadsheet/> and read overview-first (dimensions cheap, cell content fetched in ranges).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./frontend": {
      "types": "./dist/frontend.d.ts",
      "import": "./dist/frontend.js",
      "default": "./dist/frontend.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && node scripts/bundle-backend-deps.mjs",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "peerDependencies": {
    "@c4s/plugin-runtime": "*",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-router": "^1.0.0",
    "@tiptap/core": "^2.0.0",
    "better-sqlite3": "*",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@c4s/plugin-runtime": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "@tanstack/react-router": {
      "optional": true
    },
    "@tiptap/core": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@inharness-ai/claude4spec": "^1.0.22",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tiptap/core": "^2.27.2",
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "esbuild": "^0.21.5",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.9.0"
  }
}
