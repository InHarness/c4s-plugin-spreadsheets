{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // The npm-published `@inharness-ai/claude4spec` types (1.0.24) lag the local
    // runtime host, whose newer surface adds the M13 declarative backend slots
    // (`service`/`crud`/`mcpServer`, `EntityCrudService`) this plugin depends on.
    // The `c4s` CLI + dev server run from that local source, so point type
    // resolution at it so types match the runtime the plugin actually loads into.
    // Build output is unaffected (vite/esbuild externalize `@c4s/plugin-runtime`).
    "baseUrl": ".",
    "paths": {
      "@inharness-ai/claude4spec/plugin-runtime": [
        "../../claude4spec/dist/plugin-types/plugin-runtime.d.ts"
      ],
      "@inharness-ai/claude4spec/plugin-runtime/ui": [
        "../../claude4spec/dist/plugin-types/ui.d.ts"
      ]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noEmit": true
  },
  "include": ["src", "vite.config.ts"]
}
